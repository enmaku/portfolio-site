# TMDB for Movie Vote — set at least one (https://www.themoviedb.org/settings/api).
# Prefer Read Access Token (Bearer); otherwise v3 API key works.
#
# Local: copy to `.env` (gitignored), restart `quasar dev`.
# GitHub Actions: add secrets `TMDB_READ_ACCESS_TOKEN` and/or `TMDB_API_KEY`.
VITE_TMDB_READ_ACCESS_TOKEN=
VITE_TMDB_API_KEY=

# Firebase — Movie Vote, Game Timer, Game Manager auth, Dungeon Runner replay archive (RTDB), and match outcomes (Firestore).
# Share VITE_FIREBASE_* below in one Firebase project; path-scoped RTDB rules in database.rules.json; Firestore rules in firestore.rules.
# VITE_FIREBASE_DATABASE_URL must be the Realtime Database URL (Build → Realtime Database), not Firestore.
# After changing rules locally, deploy: `npx firebase-tools deploy --only database --project <project-id>`
# Probe live RTDB from the CLI: `npm run check:firebase-rtdb` (after filling this file).
# Local emulators: `firebase emulators:start --only database,firestore` (RTDB :9001, Firestore :8080).
# Console: Project settings → Your apps → Web app config + Realtime Database URL.
# GitHub Actions: add the same names as repository secrets (see publish.yml).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional (standard Firebase web template)
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# Dungeon Runner — when unset or not 1/true/yes, NN runner picks adventurer at random (match RNG).
# Set to true on local dev to restore NN adventurer selection. Restart `quasar dev` after change.
# VITE_DUNGEON_RUNNER_NN_PICK_ADVENTURER=true

# Dungeon Runner sibling checkout — https://github.com/enmaku/dungeon-runner
# Model sync: scripts/sync-dungeon-runner-model.mjs, convert-dungeon-runner-h5.mjs (models/<version>/policy.weights.h5).
# Parity: analytics/matchOutcomeDeriveParity.test.mjs spawns derive_match_outcome.mjs when set (skips when unset).
DUNGEON_RUNNER_ROOT=
# Python with TensorFlow + tensorflowjs for H5→TF.js (dungeon-runner training venv is typical).
# PYTHON_BIN=/absolute/path/to/dungeon-runner/.venv/bin/python

# Game Manager — BoardGameGeek catalog proxy (Cloud Functions only; never VITE_*).
# Register a BGG application for a Bearer token: https://boardgamegeek.com/using_the_api
# Local Functions emulator: export GAME_MANAGER_API_KEY or put it in functions/.env (gitignored).
# Deploy: `firebase functions:secrets:set GAME_MANAGER_API_KEY` (see functions/README.md).
GAME_MANAGER_API_NAME=
GAME_MANAGER_API_KEY=

# Game Manager — browser base URL for BGG catalog Cloud Functions (no API key here).
# Emulator example: http://127.0.0.1:5001/<firebase-project-id>/us-central1
# Production fallback when unset: https://us-central1-<VITE_FIREBASE_PROJECT_ID>.cloudfunctions.net
VITE_GAME_MANAGER_BGG_FUNCTIONS_BASE=

# Local only — Firestore admin upload of BGG catalog index (scripts/bgg-upload-catalog-search-index.mjs).
# Not used by the Quasar app. Download a service account key from Firebase Console (never commit it):
#   export GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=