rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /dungeonRunnerMatchOutcomes/{matchId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/dungeonRunnerMatchOutcomes/$(matchId));
      allow update, delete: if false;
    }

    match /bggCatalogGames/{bggId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Server-only BGG /thing response cache (Admin SDK). Clients must not read or write.
    match /bggThingCache/{bggId} {
      allow read, write: if false;
    }

    match /gameManagerOwners/{ownerUid} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == ownerUid;
      }
    }
  }
}
