rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /dungeonRunnerMatchOutcomes/{matchId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/dungeonRunnerMatchOutcomes/$(matchId));
      allow update, delete: if false;
    }

    match /bggCatalogGames/{bggId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Server-only BGG /thing response cache (Admin SDK). Clients must not read or write.
    match /bggThingCache/{bggId} {
      allow read, write: if false;
    }

    match /gameManagerOwners/{ownerUid} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == ownerUid;
      }
    }

    function isTimeTrackerOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    function timeTrackerLinkPath(secret) {
      return /databases/$(database)/documents/timeTrackerInvoiceLinks/$(secret);
    }

    function isValidTimeTrackerCapability(ownerUid, clientId, secret) {
      return secret is string
        && secret.size() > 20
        && exists(timeTrackerLinkPath(secret))
        && get(timeTrackerLinkPath(secret)).data.ownerUid == ownerUid
        && get(timeTrackerLinkPath(secret)).data.clientId == clientId;
    }

    match /timeTrackerInvoiceLinks/{secret} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /timeTrackerOwners/{ownerUid} {
      allow read, write: if isTimeTrackerOwner(ownerUid);

      match /invoices/{invoiceId} {
        allow read: if isTimeTrackerOwner(ownerUid)
          || isValidTimeTrackerCapability(ownerUid, resource.data.clientId, resource.data.linkSecret);
        allow create, delete: if isTimeTrackerOwner(ownerUid);
        allow update: if isTimeTrackerOwner(ownerUid)
          || (
            isValidTimeTrackerCapability(ownerUid, resource.data.clientId, resource.data.linkSecret)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountPaidCents'])
          );
      }

      match /{document=**} {
        allow read, write: if isTimeTrackerOwner(ownerUid);
      }
    }
  }
}
